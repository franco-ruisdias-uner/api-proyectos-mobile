# ─────────────────────────────────────────────────────────────────────────────
#  Configuración de la API. Copiá este archivo como .env y cambiá lo que haga falta.
#  Con lo que viene acá, la API arranca con SQLite y no hay que instalar nada más.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto donde escucha la API (los hosts como Render usan PORT; si está PUERTO, gana PUERTO).
PUERTO=3000

# desarrollo | test | publicado
ENTORNO=desarrollo

# Clave para firmar las sesiones. ÉSTA ES DE DESARROLLO: no la uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ────────────────────────────────────────────────────────────
# Motor: better-sqlite3 (default) | postgres | mysql | mariadb
DB_MOTOR=better-sqlite3
# Con SQLite, el archivo de la base:
DB_ARCHIVO=datos/api.sqlite
# Crea las tablas desde las entidades al arrancar.
DB_SINCRONIZAR=true

# PostgreSQL instalado a mano (o el de `docker compose -f compose.postgres.yaml up`, puerto 5433):
# DB_MOTOR=postgres
# DB_URL=postgres://api:api@localhost:5433/api

# MySQL 8:
# DB_MOTOR=mysql
# DB_URL=mysql://api:api@localhost:3307/api

# MariaDB (¡XAMPP instala MariaDB, no MySQL! Usá mariadb aunque el panel diga "MySQL"):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/transporte

# ── Base de datos administrada en la nube (opcional) ─────────────────────────
# DB_PROVEEDOR completa el motor, el cifrado (SSL) y el esquema, y revisa que DB_URL sea la
# correcta: supabase | neon | aiven-postgres | aiven-mysql.
#
# Supabase: panel del proyecto → «Connect» → «Session pooler» (puerto 5432; NO el directo ni el 6543).
#   La contraseña es la que elegiste al crear el proyecto (si tiene @ # /, escribilos con %).
# DB_PROVEEDOR=supabase
# DB_URL=postgres://postgres.<id-del-proyecto>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#
# Neon: panel → «Connect». Aiven: panel del servicio → «Connection information».
# DB_PROVEEDOR=neon
# DB_URL=postgres://<usuario>:<contraseña>@ep-xxxx.sa-east-1.aws.neon.tech/neondb
#
# Cifrado: no | si (verifica el certificado) | si-sin-verificar (cifra sin verificar).
# El preset ya elige uno; con DB_SSL_CA (ruta al certificado de la CA del proveedor) verifica.
# DB_SSL=si-sin-verificar
# DB_SSL_CA=./certificados/ca.pem
# Esquema de PostgreSQL donde van las tablas (Supabase: api, para que no queden en public).
# DB_ESQUEMA=api
# Probá la conexión con:  pnpm db:probar

# Si la contraseña tiene caracteres raros (@, #, /), escribilos con %: @ → %40, # → %23.

# Al arrancar, si la base está vacía, carga los datos de demo.
SEMBRAR_SI_VACIA=true

# ── Archivos (fotos, audio, video) ───────────────────────────────────────────
# local (disco) | supabase | aws | r2 | b2 | s3proxy | localstack
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos

# Todos los proveedores en la nube hablan el protocolo de S3. Las claves se generan en el panel
# del proveedor, y son sólo para el servidor: no las subas a git.
# Probá la configuración con:  pnpm archivos:probar
#
# Supabase Storage: Storage → «S3 Connection» (endpoint y región) y «Access keys» (las claves).
#   Antes creá un bucket (privado) en Storage → «New bucket».
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=<las letras de https://<proyecto>.supabase.co>
# S3_REGION=sa-east-1
# S3_BUCKET=archivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Amazon S3: bucket y región en la consola de AWS; claves en IAM → «Access keys».
# ARCHIVOS_PROVEEDOR=aws
# S3_BUCKET=
# S3_REGION=sa-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Cloudflare R2: ID de cuenta en el panel de R2; claves en R2 → «Manage API tokens».
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Backblaze B2: la región sale del endpoint del bucket (s3.<región>.backblazeb2.com);
#   las claves, en «Application Keys».
# ARCHIVOS_PROVEEDOR=b2
# S3_BUCKET=
# S3_REGION=us-west-004
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Otro servicio compatible con S3: pisa lo que diga el preset.
# S3_ENDPOINT=https://s3.mi-servicio.com
# S3_FORZAR_PATH_STYLE=true
# Con un emulador (s3proxy, localstack) la API crea el bucket sola; con un proveedor, no.
# ARCHIVOS_CREAR_BUCKET=false
# En vez de pasar cada archivo por la API, responder 302 a una URL firmada de 15 minutos.
# ARCHIVOS_REDIRIGIR=false

# Dirección pública de la API. No hace falta: si no está, las URLs de los archivos se arman
# con la dirección que usó el teléfono para llegar (por ejemplo http://192.168.0.10:3000).
# URL_PUBLICA=https://mi-api.onrender.com

# ENTORNO=publicado: la API no arranca con SQLite, con archivos locales, con el JWT_SECRETO de
# desarrollo (o de menos de 32 caracteres) ni con SIMULACION_HABILITADA=true.

# Detrás del proxy de un host (Render, Koyeb): confiar en X-Forwarded-Proto/Host.
CONFIAR_PROXY=false

# ── Notificaciones push ──────────────────────────────────────────────────────
# expo: las manda de verdad por Expo · registro: sólo las escribe en la consola
NOTIFICACIONES=expo

# ── Para probar ──────────────────────────────────────────────────────────────
# Cabecera X-Simular: error-500 | demora-3000 (default: true en desarrollo)
SIMULACION_HABILITADA=true

# Congela el reloj de la API en ese instante (con zona). Sirve para probar, por ejemplo,
# qué muestra la app cuando ya pasó el último colectivo.
# RELOJ_FIJO=2026-11-14T22:00:00-03:00
