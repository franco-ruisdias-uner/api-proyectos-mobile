# Copiá este archivo a .env y cambiá lo que necesites. Con lo que trae, la API anda con SQLite.

# ── General ───────────────────────────────────────────────────────────────────
# Puerto donde escucha la API (si no está, usa PORT, que es lo que ponen los hosts).
PUERTO=3000
# desarrollo | test | publicado. Con "publicado" la API no arranca si la base es SQLite, los archivos
# son locales, JWT_SECRETO es el de desarrollo o tiene menos de 32 caracteres, o la simulación está prendida.
ENTORNO=desarrollo
# Dirección pública de la API, sin barra final. No hace falta: si no está, las URLs de
# los archivos se arman con la dirección que usó el teléfono (http://192.168.0.10:3000).
# URL_PUBLICA=
# true si la API está detrás de un proxy que pone X-Forwarded-Proto (Render, Koyeb).
CONFIAR_PROXY=false

# ── Sesiones ──────────────────────────────────────────────────────────────────
# Clave para firmar los tokens. ESTA ES DE DESARROLLO: no la uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ─────────────────────────────────────────────────────────────
# better-sqlite3 (por defecto, no hay que instalar nada) | postgres | mysql | mariadb
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite
# Crear o actualizar las tablas al arrancar (desde las entidades).
DB_SINCRONIZAR=true
# Al arrancar, si la base está vacía, cargar los datos de demo.
SEMBRAR_SI_VACIA=true

# PostgreSQL instalado en la compu:
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:clave@localhost:5432/api

# MySQL instalado en la compu:
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/api

# MariaDB (XAMPP instala MariaDB, no MySQL: usá "mariadb"):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# ── Base de datos en la nube (opcional) ───────────────────────────────────────
# Un preset completa motor, cifrado (SSL) y esquema, y revisa que DB_URL sea la correcta.
# DB_PROVEEDOR=supabase | neon | aiven-postgres | aiven-mysql
#
# Supabase: Connect → "Session pooler" (host …pooler.supabase.com, puerto 5432, usuario
# postgres.<referencia>). NO la conexión directa (sólo IPv6) ni el modo transacción (6543).
# Las tablas van en el esquema "api" (DB_ESQUEMA). El plan gratis se pausa tras una semana sin uso.
# DB_PROVEEDOR=supabase
# DB_URL=postgres://postgres.<referencia>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Neon (panel → Connect): DB_PROVEEDOR=neon, DB_URL=postgres://…neon.tech/…
# Aiven (pantalla del servicio): DB_PROVEEDOR=aiven-postgres o aiven-mysql, DB_URL=…aivencloud.com…
#
# DB_SSL: no | si (cifra y verifica) | si-sin-verificar (cifra sin verificar). El preset ya elige.
# DB_SSL_CA: ruta al certificado de la CA que da el proveedor (fuera de git): verifica contra ése.
# DB_ESQUEMA: esquema de PostgreSQL para las tablas (el preset de Supabase usa "api").
# Probar la conexión: pnpm db:probar

# ── Archivos (fotos, audios, videos) ──────────────────────────────────────────
# local (una carpeta) | aws | supabase | r2 | b2 | s3proxy | localstack
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos
# Claves S3 (todos menos local, s3proxy y localstack): se generan en el panel del proveedor.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # pisa el del preset (cualquier otro servicio compatible con S3)
# S3_FORZAR_PATH_STYLE=     # true | false: pisa el del preset
# ARCHIVOS_REDIRIGIR=false  # true: la API responde 302 a una URL firmada de 15 minutos
# ARCHIVOS_CREAR_BUCKET=    # true: crea el bucket si no existe (los emuladores ya lo hacen)
#
# Supabase Storage: Project Settings → Storage → S3 Connection: generá las claves ahí (sólo para el
# servidor). Región = la del proyecto.
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=<referencia del proyecto>
#
# Cloudflare R2: región fija "auto". R2_CUENTA = ID de cuenta (panel de R2).
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=
#
# Backblaze B2: S3_REGION = la del bucket, por ejemplo us-west-004.
# ARCHIVOS_PROVEEDOR=b2
#
# AWS S3: S3_REGION = la del bucket.
# ARCHIVOS_PROVEEDOR=aws
#
# Probar los archivos: pnpm archivos:probar
# (Firebase Storage no se soporta: exige facturación y no habla S3.)

# ── Notificaciones push ───────────────────────────────────────────────────────
# expo (las manda de verdad a los teléfonos) | registro (sólo las escribe en la consola)
NOTIFICACIONES=registro
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar ───────────────────────────────────────────────────────────────
# Congelar el reloj de la API en un momento (fecha y hora con zona):
# RELOJ_FIJO=2026-09-15T08:00:00-03:00
# Cabecera X-Simular (error-500, demora-3000). Prendida por defecto en desarrollo.
SIMULACION_HABILITADA=true
