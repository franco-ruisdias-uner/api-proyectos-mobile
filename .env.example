# Configuración de la API. Copiá este archivo como .env y cambiá lo que necesites.
# Si falta algo o está mal, la API no arranca y te dice qué arreglar.

# ─── Servidor ────────────────────────────────────────────────────────────────
# Puerto donde escucha (en 0.0.0.0, para que el teléfono llegue por la IP de la compu).
PUERTO=3000
# desarrollo | publicado. `publicado` exige base y archivos en la nube, un JWT_SECRETO propio
# de 32+ caracteres y SIMULACION_HABILITADA=false: si no, la API no arranca.
ENTORNO=desarrollo
# true sólo si la API está detrás de un proxy (Render, Koyeb): usa X-Forwarded-Proto/Host.
CONFIAR_PROXY=false
# Dirección pública de la API. Vacía: las URLs de las fotos usan la dirección con la que
# llegó el teléfono (http://192.168.0.10:3000). No hace falta tocarla.
URL_PUBLICA=

# ─── Base de datos ───────────────────────────────────────────────────────────
# better-sqlite3 (default, no hay que instalar nada) | postgres | mysql | mariadb
# OJO: XAMPP instala MariaDB, no MySQL. Con XAMPP usá DB_MOTOR=mariadb.
DB_MOTOR=better-sqlite3

# SQLite: archivo de la base.
DB_ARCHIVO=datos/api.sqlite

# PostgreSQL:
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:clave@localhost:5432/api
# MySQL:
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/api
# MariaDB (XAMPP):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# Base administrada en la nube (reemplaza a DB_MOTOR; completa motor, SSL y esquema).
# Probá la conexión con: pnpm db:probar
# Supabase: DB_URL es la del «Session pooler» (host …pooler.supabase.com, puerto 5432,
# usuario postgres.<referencia>). No uses la conexión directa (IPv6) ni el puerto 6543.
# DB_PROVEEDOR=supabase
# DB_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Neon: DB_PROVEEDOR=neon · Aiven: DB_PROVEEDOR=aiven-postgres | aiven-mysql
# no | si (verifica el certificado) | si-sin-verificar; con un preset ya viene elegido.
# DB_SSL=si-sin-verificar
# Ruta al certificado de la CA del proveedor (fuera de git): con ella se verifica el certificado.
# DB_SSL_CA=
# Esquema de PostgreSQL donde van las tablas (Supabase: api).
# DB_ESQUEMA=api

# Crea o ajusta las tablas al arrancar. Dejalo en true.
DB_SINCRONIZAR=true
# true: si la base está vacía al arrancar, carga los datos de demo.
SEMBRAR_SI_VACIA=false

# ─── Sesiones ────────────────────────────────────────────────────────────────
# Secreto con el que se firman los tokens. ESTE ES DE DESARROLLO: no lo uses publicado.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ─── Archivos (fotos, audios, videos) ────────────────────────────────────────
# local (default): en una carpeta de esta computadora.
# En la nube: aws | supabase | r2 | b2 (más abajo). Emuladores: s3proxy | localstack (Docker).
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos
# true: la API responde 302 a una URL firmada de 15 minutos en vez de pasar el archivo.
# ARCHIVOS_REDIRIGIR=false

# Las claves S3 son secretas: van sólo acá, nunca en el repo. Probá la configuración con:
#   pnpm archivos:probar
# Supabase Storage (Project Settings → Storage → S3 Connection; el bucket se crea en Storage):
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=<referencia del proyecto: Project Settings → General → Reference ID>
# S3_REGION=<región del proyecto, p. ej. sa-east-1>
# S3_BUCKET=<nombre del bucket>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Cloudflare R2 (R2 → Manage API tokens; la cuenta está en el panel de R2):
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=<Account ID>
# S3_BUCKET=<nombre del bucket>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Backblaze B2 (Application Keys; la región está en el endpoint del bucket):
# ARCHIVOS_PROVEEDOR=b2
# S3_REGION=<p. ej. us-west-004>
# S3_BUCKET=<nombre del bucket>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AWS S3:
# ARCHIVOS_PROVEEDOR=aws
# S3_REGION=<región del bucket>
# S3_BUCKET=<nombre del bucket>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Otro servicio compatible con S3: cualquier proveedor + S3_ENDPOINT y S3_FORZAR_PATH_STYLE.

# ─── Notificaciones push ─────────────────────────────────────────────────────
# expo: las manda por el servicio de Expo | registro: sólo las escribe en la consola.
NOTIFICACIONES=expo
# Dirección del servicio de push de Expo (no hace falta tocarla).
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ─── Para probar ─────────────────────────────────────────────────────────────
# Congela el reloj de la API en ese momento (vacío: la hora real).
# RELOJ_FIJO=2026-09-14T10:00:00-03:00
RELOJ_FIJO=
# Cabecera X-Simular: error-500 o demora-3000 para probar errores y esperas en la app.
SIMULACION_HABILITADA=true
