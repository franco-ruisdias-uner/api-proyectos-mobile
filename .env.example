# Copiá este archivo a .env y cambiá lo que necesites. Con lo que trae, la API anda con SQLite.

# ── General ───────────────────────────────────────────────────────────────────
# Puerto donde escucha la API (si no está, usa PORT, que es lo que ponen los hosts).
PUERTO=3000
# desarrollo | test | publicado
ENTORNO=desarrollo
# Dirección pública de la API, sin barra final. No hace falta: si no está, las URLs de
# los archivos se arman con la dirección que usó el teléfono (http://192.168.0.10:3000).
# URL_PUBLICA=
# true si la API está detrás de un proxy que pone X-Forwarded-Proto (Render, Koyeb).
CONFIAR_PROXY=false

# ── Sesiones ──────────────────────────────────────────────────────────────────
# Clave para firmar los tokens. ESTA ES DE DESARROLLO: no la uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ─────────────────────────────────────────────────────────────
# better-sqlite3 (por defecto, no hay que instalar nada) | postgres | mysql | mariadb
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite
# Crear o actualizar las tablas al arrancar (desde las entidades).
DB_SINCRONIZAR=true
# Al arrancar, si la base está vacía, cargar los datos de demo.
SEMBRAR_SI_VACIA=true

# PostgreSQL instalado en la compu:
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:clave@localhost:5432/api

# MySQL instalado en la compu:
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/api

# MariaDB (XAMPP instala MariaDB, no MySQL: usá "mariadb"):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# ── Archivos (fotos, audios, videos) ──────────────────────────────────────────
# Por ahora, sólo "local": se guardan en una carpeta.
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos

# ── Notificaciones push ───────────────────────────────────────────────────────
# expo (las manda de verdad a los teléfonos) | registro (sólo las escribe en la consola)
NOTIFICACIONES=registro
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar ───────────────────────────────────────────────────────────────
# Congelar el reloj de la API en un momento (fecha y hora con zona):
# RELOJ_FIJO=2026-09-15T08:00:00-03:00
# Cabecera X-Simular (error-500, demora-3000). Prendida por defecto en desarrollo.
SIMULACION_HABILITADA=true
