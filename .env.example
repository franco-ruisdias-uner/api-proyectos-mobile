# Configuración de la API. Copiá este archivo como .env y cambiá lo que necesites.
# Con lo que está acá (SQLite) anda sin instalar nada más.

# ── General ──────────────────────────────────────────────────────────────
PUERTO=3000
# desarrollo | test | publicado
ENTORNO=desarrollo
# Sólo si la API corre detrás de un proxy (Render, Koyeb): true
CONFIAR_PROXY=false
# Si la dejás vacía, las URLs de las fotos usan la dirección con la que llegó el teléfono.
URL_PUBLICA=

# ── Base de datos ────────────────────────────────────────────────────────
# better-sqlite3 (default, sin instalar nada) | postgres | mysql | mariadb
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite
# PostgreSQL:
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:clave@localhost:5432/reservas
# MySQL 8:
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/reservas
# MariaDB (¡XAMPP instala MariaDB, no MySQL!):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/reservas
# Bases administradas en la nube (completan motor, SSL y esquema solas):
#   supabase | neon | aiven-postgres | aiven-mysql
# Supabase: DB_URL es la cadena del «Session pooler» (puerto 5432), no la directa.
# DB_PROVEEDOR=supabase
# DB_URL=postgres://postgres.<referencia>:<clave>@aws-0-<región>.pooler.supabase.com:5432/postgres
# DB_SSL=no | si | si-sin-verificar   (el preset ya elige uno)
# DB_SSL_CA=ruta/al/certificado-de-la-CA.pem
# DB_ESQUEMA=api
DB_SINCRONIZAR=true
# Al arrancar, si la base está vacía, carga los datos de demo.
SEMBRAR_SI_VACIA=true

# ── Sesiones ─────────────────────────────────────────────────────────────
# Clave de DESARROLLO. Nunca la uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Archivos (fotos, audio, video) ───────────────────────────────────────
# local (disco, default) | aws | supabase | r2 | b2 | s3proxy | localstack
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos
# Los proveedores en la nube usan las claves S3 (se generan en el panel de cada uno):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=archivos
# Supabase (Project Settings → General, y Storage → S3 Connection):
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=<referencia del proyecto>
# S3_REGION=<región del proyecto, p. ej. sa-east-1>
# Cloudflare R2 (R2 → Manage API tokens; la región es siempre auto):
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=<ID de la cuenta de Cloudflare>
# Backblaze B2 (Buckets → endpoint s3.<región>.backblazeb2.com):
# ARCHIVOS_PROVEEDOR=b2
# S3_REGION=<p. ej. us-west-004>
# AWS S3:
# ARCHIVOS_PROVEEDOR=aws
# S3_REGION=<región del bucket>
# Cualquier otro servicio compatible con S3:
# S3_ENDPOINT=https://...
# S3_FORZAR_PATH_STYLE=true

# ── Notificaciones push ──────────────────────────────────────────────────
# registro: sólo las escribe en la consola · expo: las manda de verdad por Expo
NOTIFICACIONES=registro
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar la app ───────────────────────────────────────────────────
# Cabecera X-Simular: error-500 | demora-3000
SIMULACION_HABILITADA=true
# Congela el reloj de la API en un instante (vacío = hora real):
# RELOJ_FIJO=2026-09-19T20:30:00-03:00
RELOJ_FIJO=
