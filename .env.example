# Copiá este archivo a .env y ajustalo. Lo que no definas toma el valor por defecto.
# Si falta algo obligatorio o algo está mal, la API no arranca y te dice qué cambiar.

# ── General ────────────────────────────────────────────────────────────────────
# Puerto donde escucha la API (también acepta PORT, que es lo que ponen los hosts).
PUERTO=3000
# desarrollo | test
ENTORNO=desarrollo
# Dirección pública de la API. No hace falta: si no está, las URLs de las fotos usan la
# dirección con la que llegó el teléfono (por ejemplo http://192.168.0.10:3000).
# URL_PUBLICA=https://mi-api.onrender.com
# true si la API corre detrás de un proxy (Render, Koyeb): las URLs salen con https.
CONFIAR_PROXY=false

# ── Sesiones ───────────────────────────────────────────────────────────────────
# Clave con la que se firman los tokens. ÉSTA ES DE DESARROLLO: no la uses publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ──────────────────────────────────────────────────────────────
# Elegí UNO de los cuatro bloques.

# 1) SQLite (por defecto, no hay que instalar nada)
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite

# 2) PostgreSQL
# DB_MOTOR=postgres
# DB_URL=postgres://api:api@localhost:5432/api

# 3) MySQL
# DB_MOTOR=mysql
# DB_URL=mysql://api:api@localhost:3306/api

# 4) MariaDB — OJO: XAMPP instala MariaDB, no MySQL. Con XAMPP usá este bloque.
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# Crear/actualizar las tablas al arrancar a partir del código (no hay migraciones).
DB_SINCRONIZAR=true
# Si la base está vacía al arrancar, cargar los datos de demo.
SEMBRAR_SI_VACIA=false

# ── Archivos (fotos, audios, videos) ───────────────────────────────────────────
# Por ahora sólo "local": se guardan en una carpeta de la computadora.
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos

# ── Notificaciones push ────────────────────────────────────────────────────────
# expo: las manda de verdad a Expo · registro: sólo las escribe en la consola.
NOTIFICACIONES=expo
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar la app ─────────────────────────────────────────────────────────
# Cabecera X-Simular: error-500 / demora-3000 (ver README).
SIMULACION_HABILITADA=true
# Congela el reloj de la API en un instante (para demos y para probar casos de horario).
# RELOJ_FIJO=2026-11-14T21:00:00-03:00
