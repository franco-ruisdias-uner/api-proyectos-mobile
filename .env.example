# Copiá este archivo a .env y cambiá lo que necesites. Con lo que trae, la API anda con SQLite.

# ── General ───────────────────────────────────────────────────────────────────
# Puerto donde escucha la API (los hosts como Render ponen el suyo en PORT).
PORT=3500
# development | test | production. Con "production" la API no arranca si la base es SQLite, los archivos
# son locales, JWT_SECRET es el de desarrollo o tiene menos de 32 caracteres, o la simulación está prendida.
APP_ENV=development
# Dirección pública de la API, sin barra final. No hace falta: si no está, las URLs de
# los archivos se arman con la dirección que usó el teléfono (http://192.168.0.10:3000).
# PUBLIC_URL=
# true si la API está detrás de un proxy que pone X-Forwarded-Proto (Render, Koyeb).
TRUST_PROXY=false
# Orígenes que pueden llamar a la API desde un navegador (Expo web). * = cualquiera.
# Las apps nativas no lo usan. Publicada, conviene poner la lista: http://localhost:8081,https://mi-app.com
CORS_ORIGINS=*

# ── Logs ──────────────────────────────────────────────────────────────────────
# fatal | error | warn | log | debug | verbose (muestra ese nivel y los más graves)
LOG_LEVEL=log
# text (con colores, para la consola) | json (una línea por evento, para los hosts).
# Si no está: json con APP_ENV=production y text en el resto.
# LOG_FORMAT=text

# ── Límite de pedidos ─────────────────────────────────────────────────────────
# Cada IP puede hacer THROTTLE_LIMIT pedidos por ruta cada THROTTLE_TTL_SECONDS segundos.
# El ingreso tiene su propio límite, por IP y legajo, contra quien prueba contraseñas.
# Al pasarse, la API responde 429 DEMASIADOS_PEDIDOS.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=10

# ── Sesiones ──────────────────────────────────────────────────────────────────
# Clave para firmar los tokens. ESTA ES DE DESARROLLO: no la uses en una API publicada.
JWT_SECRET=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ─────────────────────────────────────────────────────────────
# better-sqlite3 (por defecto, no hay que instalar nada) | postgres | mysql | mariadb
#DB_ENGINE=better-sqlite3
#DB_FILE=data/api.sqlite
# Crear o actualizar las tablas al arrancar (desde las entidades).
DB_SYNCHRONIZE=true
# Al arrancar, si la base está vacía, cargar los datos de demo.
SEED_IF_EMPTY=true

# PostgreSQL instalado en la compu:
DB_ENGINE=postgres
DB_URL=postgres://postgres:password@localhost:55000/lectura-agua

# MySQL instalado en la compu:
# DB_ENGINE=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/api

# MariaDB (XAMPP instala MariaDB, no MySQL: usá "mariadb"):
# DB_ENGINE=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# ── Base de datos en la nube (opcional) ───────────────────────────────────────
# Un preset completa motor, cifrado (SSL) y esquema, y revisa que DB_URL sea la correcta.
# DB_PROVIDER=supabase | neon | aiven-postgres | aiven-mysql
#
# Supabase: Connect → "Session pooler" (host …pooler.supabase.com, puerto 5432, usuario
# postgres.<referencia>). NO la conexión directa (sólo IPv6) ni el modo transacción (6543).
# Las tablas van en el esquema "api" (DB_SCHEMA). El plan gratis se pausa tras una semana sin uso.
# DB_PROVIDER=supabase
# DB_URL=postgres://postgres.<referencia>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Neon (panel → Connect): DB_PROVIDER=neon, DB_URL=postgres://…neon.tech/…
# Aiven (pantalla del servicio): DB_PROVIDER=aiven-postgres o aiven-mysql, DB_URL=…aivencloud.com…
#
# DB_SSL: off | verify (cifra y verifica) | no-verify (cifra sin verificar). El preset ya elige.
# DB_SSL_CA: ruta al certificado de la CA que da el proveedor (fuera de git): verifica contra ése.
# DB_SCHEMA: esquema de PostgreSQL para las tablas (el preset de Supabase usa "api").
# Probar la conexión: pnpm db:probar

# ── Archivos (fotos, audios, videos) ──────────────────────────────────────────
# local (una carpeta) | aws | supabase | r2 | b2 | s3proxy | localstack
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads
# Claves S3 (todos menos local, s3proxy y localstack): se generan en el panel del proveedor.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # pisa el del preset (cualquier otro servicio compatible con S3)
# S3_FORCE_PATH_STYLE=     # true | false: pisa el del preset
# STORAGE_REDIRECT=false  # true: la API responde 302 a una URL firmada de 15 minutos
# S3_CREATE_BUCKET=    # true: crea el bucket si no existe (los emuladores ya lo hacen)
#
# Supabase Storage: Project Settings → Storage → S3 Connection: generá las claves ahí (sólo para el
# servidor). Región = la del proyecto.
# STORAGE_PROVIDER=supabase
# SUPABASE_PROJECT_REF=<referencia del proyecto>
#
# Cloudflare R2: región fija "auto". R2_ACCOUNT_ID = ID de cuenta (panel de R2).
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
#
# Backblaze B2: S3_REGION = la del bucket, por ejemplo us-west-004.
# STORAGE_PROVIDER=b2
#
# AWS S3: S3_REGION = la del bucket.
# STORAGE_PROVIDER=aws
#
# Probar los archivos: pnpm archivos:probar
# (Firebase Storage no se soporta: exige facturación y no habla S3.)

# ── Notificaciones push ───────────────────────────────────────────────────────
# expo (las manda de verdad a los teléfonos) | log (sólo las escribe en la consola)
PUSH_PROVIDER=log
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar ───────────────────────────────────────────────────────────────
# Congelar el reloj de la API en un momento (fecha y hora con zona):
# FIXED_CLOCK=2026-09-15T08:00:00-03:00
# Cabecera X-Simular (error-500, demora-3000). Prendida por defecto en development.
SIMULATION_ENABLED=true
