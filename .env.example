# Configuración de la API. Copiá este archivo como .env y cambiá lo que necesites.
# Con lo que está acá (SQLite) anda sin instalar nada más.

# ── General ──────────────────────────────────────────────────────────────
PUERTO=3000
# desarrollo | test | publicado
ENTORNO=desarrollo
# Sólo si la API corre detrás de un proxy (Render, Koyeb): true
CONFIAR_PROXY=false
# Si la dejás vacía, las URLs de las fotos usan la dirección con la que llegó el teléfono.
URL_PUBLICA=

# ── Base de datos ────────────────────────────────────────────────────────
# better-sqlite3 (default, sin instalar nada) | postgres | mysql | mariadb
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite
# PostgreSQL:
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:clave@localhost:5432/reservas
# MySQL 8:
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:clave@localhost:3306/reservas
# MariaDB (¡XAMPP instala MariaDB, no MySQL!):
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/reservas
DB_SINCRONIZAR=true
# Al arrancar, si la base está vacía, carga los datos de demo.
SEMBRAR_SI_VACIA=true

# ── Sesiones ─────────────────────────────────────────────────────────────
# Clave de DESARROLLO. Nunca la uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Archivos (fotos, audio, video) ───────────────────────────────────────
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos

# ── Notificaciones push ──────────────────────────────────────────────────
# registro: sólo las escribe en la consola · expo: las manda de verdad por Expo
NOTIFICACIONES=registro
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar la app ───────────────────────────────────────────────────
# Cabecera X-Simular: error-500 | demora-3000
SIMULACION_HABILITADA=true
# Congela el reloj de la API en un instante (vacío = hora real):
# RELOJ_FIJO=2026-09-19T20:30:00-03:00
RELOJ_FIJO=
