# Copiá este archivo a .env y ajustalo. Lo que no definas toma el valor por defecto.
# Si falta algo obligatorio o algo está mal, la API no arranca y te dice qué cambiar.

# ── General ────────────────────────────────────────────────────────────────────
# Puerto donde escucha la API (también acepta PORT, que es lo que ponen los hosts).
PUERTO=3000
# desarrollo | test | publicado
# «publicado» es para cuando la API corre en un host (Render): la API NO arranca si queda algo de
# desarrollo (SQLite, archivos en disco, el JWT_SECRETO de ejemplo, la simulación de fallas).
ENTORNO=desarrollo
# Dirección pública de la API. No hace falta: si no está, las URLs de las fotos usan la
# dirección con la que llegó el teléfono (por ejemplo http://192.168.0.10:3000).
# URL_PUBLICA=https://mi-api.onrender.com
# true si la API corre detrás de un proxy (Render, Koyeb): las URLs salen con https.
CONFIAR_PROXY=false

# ── Sesiones ───────────────────────────────────────────────────────────────────
# Clave con la que se firman los tokens. ÉSTA ES DE DESARROLLO: no la uses publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# ── Base de datos ──────────────────────────────────────────────────────────────
# Elegí UNO de los cuatro bloques.

# 1) SQLite (por defecto, no hay que instalar nada)
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite

# 2) PostgreSQL
# DB_MOTOR=postgres
# DB_URL=postgres://api:api@localhost:5432/api

# 3) MySQL
# DB_MOTOR=mysql
# DB_URL=mysql://api:api@localhost:3306/api

# 4) MariaDB — OJO: XAMPP instala MariaDB, no MySQL. Con XAMPP usá este bloque.
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/api

# 5) Base administrada en la nube: DB_PROVEEDOR completa el motor, el cifrado y el esquema,
#    y revisa que DB_URL sea la correcta. Dejalo comentado si usás uno de los bloques de arriba.
#    supabase | neon | aiven-postgres | aiven-mysql
# DB_PROVEEDOR=supabase
#   Supabase: usá el «Session pooler» (Connect → Session pooler): host …pooler.supabase.com, puerto 5432,
#   usuario postgres.<id del proyecto>. La conexión directa es sólo IPv6 y el modo transacción (6543) no sirve.
# DB_URL=postgres://postgres.abcdefgh:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   Si la clave tiene símbolos (@ / # :), escribilos codificados (%40 %2F %23 %3A).
#   Neon:   DB_URL=postgres://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb
#   Aiven:  DB_URL=postgres://avnadmin:clave@pg-xxxx.aivencloud.com:12345/defaultdb
# Cifrado: no | si (verifica el certificado) | si-sin-verificar (cifra sin verificar, como sslmode=require).
# DB_SSL=si-sin-verificar
# Ruta al certificado de la CA que da el proveedor (fuera de git): con ella se verifica el certificado.
# DB_SSL_CA=./certificados/ca.pem
# Esquema de PostgreSQL donde van las tablas (supabase: api; neon y aiven: public). La API lo crea.
# DB_ESQUEMA=api

# Crear/actualizar las tablas al arrancar a partir del código (no hay migraciones).
DB_SINCRONIZAR=true
# Si la base está vacía al arrancar, cargar los datos de demo.
SEMBRAR_SI_VACIA=false

# ── Archivos (fotos, audios, videos) ───────────────────────────────────────────
# local | aws | supabase | r2 | b2 | s3proxy | localstack
# Con cualquiera que no sea «local» los archivos van a un servicio compatible con S3; la app no
# se entera: las URLs son siempre <tu API>/archivos/<clave>.
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=./archivos

# --- Proveedores en la nube (descomentá un bloque) ---
# Las claves S3 son SECRETAS: van sólo acá (.env no se sube a git).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Supabase Storage: Storage → Buckets (creá uno) y Storage → S3 Connection (generá las claves).
#   S3_REGION es la región del proyecto (por ejemplo sa-east-1). Cada archivo puede pesar hasta 50 MB en el plan gratis.
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=abcdefgh
# S3_BUCKET=archivos
# S3_REGION=sa-east-1
#
# Cloudflare R2: R2 → Overview (Account ID) y «Manage API tokens» (claves S3). La región es siempre «auto».
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=0123456789abcdef
# S3_BUCKET=archivos
#
# Backblaze B2: Buckets (endpoint y región, por ejemplo us-west-004) y «Application Keys».
# ARCHIVOS_PROVEEDOR=b2
# S3_BUCKET=archivos
# S3_REGION=us-west-004
#
# AWS S3: consola de S3 (bucket y región) e IAM (claves).
# ARCHIVOS_PROVEEDOR=aws
# S3_BUCKET=archivos
# S3_REGION=sa-east-1
#
# Cualquier otro servicio compatible con S3 (MinIO, Wasabi…): pisa lo que dice el preset.
# S3_ENDPOINT=https://minio.mi-red:9000
# S3_FORZAR_PATH_STYLE=true
#
# Con Docker (emuladores, ver README): docker compose -f compose.yaml -f compose.almacen-s3.yaml up
# true: en vez de pasar el archivo por la API, responde 302 a una URL firmada de 15 minutos
# (sólo proveedores en la nube; con emuladores en Docker el teléfono no llega a esa URL).
# ARCHIVOS_REDIRIGIR=false

# ── Notificaciones push ────────────────────────────────────────────────────────
# expo: las manda de verdad a Expo · registro: sólo las escribe en la consola.
NOTIFICACIONES=expo
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Para probar la app ─────────────────────────────────────────────────────────
# Cabecera X-Simular: error-500 / demora-3000 (ver README).
SIMULACION_HABILITADA=true
# Congela el reloj de la API en un instante (para demos y para probar casos de horario).
# RELOJ_FIJO=2026-11-14T21:00:00-03:00
