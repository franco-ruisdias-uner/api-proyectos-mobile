# Configuración de la API. Copiá este archivo a .env (cp .env.example .env) y cambiá lo que haga falta.
# Si algo está mal, la API no arranca y te dice qué variable arreglar.

# --- General -----------------------------------------------------------------------------------
# Puerto donde escucha la API. Si no está, usa PORT (lo que inyectan Render y Koyeb) o 3000.
PUERTO=3000
# desarrollo | publicado
ENTORNO=desarrollo
# Firma de los tokens de sesión. ESTE ES DE DESARROLLO: no lo uses en una API publicada.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion
# Dirección pública de la API. No hace falta: si está vacía, las URLs de las fotos se arman
# con la dirección que usó el teléfono (por ejemplo http://192.168.0.10:3000).
URL_PUBLICA=
# true si la API corre detrás de un proxy (Render, Koyeb): así las URLs salen con https.
CONFIAR_PROXY=false

# --- Base de datos: elegí UNO de los cuatro bloques ---------------------------------------------
# 1) SQLite (por defecto): no hay que instalar nada. La base queda en un archivo.
DB_MOTOR=better-sqlite3
DB_ARCHIVO=datos/api.sqlite

# 2) PostgreSQL
# DB_MOTOR=postgres
# DB_URL=postgres://usuario:contraseña@localhost:5432/mi_ciudad

# 3) MySQL 8
# DB_MOTOR=mysql
# DB_URL=mysql://usuario:contraseña@localhost:3306/mi_ciudad

# 4) MariaDB. ¡OJO! XAMPP instala MariaDB, no MySQL: si usás XAMPP, poné mariadb.
# DB_MOTOR=mariadb
# DB_URL=mysql://root:@localhost:3306/mi_ciudad

# Crea las tablas desde el código al arrancar. Dejalo en true.
DB_SINCRONIZAR=true
# Si la base está vacía al arrancar, carga los datos de demo (lo usan los compose de Docker).
SEMBRAR_SI_VACIA=false

# --- Archivos (fotos, audios, videos) -----------------------------------------------------------
# local: en una carpeta de esta computadora. En la nube: aws, supabase, r2 o b2 (y s3proxy /
# localstack, emuladores de Docker; ver los compose.storage-*.yaml).
ARCHIVOS_PROVEEDOR=local
DIRECTORIO_ARCHIVOS=archivos
# --- Archivos en la nube (descomentá un bloque). Las claves S3 sólo van acá, nunca en git. ---
# Supabase: Storage > S3 Configuration (SUPABASE_PROYECTO es el id del proyecto, la región la ves ahí).
# ARCHIVOS_PROVEEDOR=supabase
# SUPABASE_PROYECTO=abcdefghijklmnop
# S3_REGION=sa-east-1
# S3_BUCKET=archivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Cloudflare R2: R2_CUENTA es el id de cuenta del panel; la región es siempre auto.
# ARCHIVOS_PROVEEDOR=r2
# R2_CUENTA=
# Backblaze B2: la región sale del endpoint del bucket (p. ej. us-west-004).
# ARCHIVOS_PROVEEDOR=b2
# AWS S3: la región del bucket.
# ARCHIVOS_PROVEEDOR=aws
# Cualquier otro servicio compatible con S3: S3_ENDPOINT y, si hace falta, S3_FORZAR_PATH_STYLE=true.
# ARCHIVOS_REDIRIGIR=true responde con una URL firmada de 15 minutos en vez de pasar el archivo.

# --- Base en la nube (opcional; pisa DB_MOTOR) ------------------------------------------------------
# supabase: usá la cadena del pooler en modo SESIÓN (puerto 5432, usuario postgres.<ref>).
# Otros: neon, aiven-postgres, aiven-mysql. DB_SSL=no|si|si-sin-verificar, DB_SSL_CA=ruta al certificado.
# DB_PROVEEDOR=supabase
# DB_URL=postgres://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DB_ESQUEMA=api

# --- Publicado (Render, Koyeb…) ---------------------------------------------------------------------
# ENTORNO=publicado no arranca con SQLite, archivos en disco, JWT de desarrollo o simulación activa.
# CONFIAR_PROXY=true hace que las URLs de archivos salgan https detrás del proxy del host.

# --- Notificaciones push ------------------------------------------------------------------------
# expo: las manda de verdad por Expo · registro: sólo las escribe en la consola
NOTIFICACIONES=expo

# --- Para probar ----------------------------------------------------------------------------------
# Con true, la cabecera X-Simular: error-500 o X-Simular: demora-3000 simula fallas y demoras.
SIMULACION_HABILITADA=true
# Congela el reloj de la API en ese momento (sirve para probar casos como "el evento ya pasó").
# RELOJ_FIJO=2026-11-14T21:00:00-03:00
