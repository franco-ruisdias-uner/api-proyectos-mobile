# Copiá este archivo como `.env` (en esta misma carpeta) y ajustá lo que necesites.
# El `.env` real NO se sube a git.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Evitá caracteres especiales en la clave (@ : / ? #): van dentro de la URL de conexión.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=post1234
POSTGRES_DB=reporte_ciudadano

# ─── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin1234

# ─── Puertos en tu compu ─────────────────────────────────────────────────────
# Si ya tenés un Postgres local en el 5432, cambiá PUERTO_DB (por ejemplo 5433).
PUERTO_API=3000
PUERTO_DB=5432
PUERTO_PGADMIN=8080

# ─── API ─────────────────────────────────────────────────────────────────────
# Solo para desarrollo local.
JWT_SECRETO=solo-para-desarrollo-no-usar-en-produccion

# --- Notifications -----------------------------------------------------------
EXPO_ACCESS_TOKEN=
