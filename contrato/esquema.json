{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArchivoSubido": {
      "additionalProperties": false,
      "description": "Respuesta de POST /archivos.",
      "properties": {
        "bytes": {
          "type": "number"
        },
        "tipo": {
          "enum": ["imagen", "audio", "video"],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["url", "tipo", "bytes"],
      "type": "object"
    },
    "AvanceRuta": {
      "additionalProperties": false,
      "description": "Respuesta de GET /rutas/:id/avance: lo que el servidor ya recibió.",
      "properties": {
        "conNovedad": {
          "type": "number"
        },
        "fueraDeRango": {
          "type": "number"
        },
        "leidos": {
          "type": "number"
        },
        "pendientes": {
          "description": "suministros - leidos - conNovedad",
          "type": "number"
        },
        "rutaId": {
          "type": "string"
        },
        "suministros": {
          "type": "number"
        }
      },
      "required": [
        "rutaId",
        "suministros",
        "leidos",
        "conNovedad",
        "pendientes",
        "fueraDeRango"
      ],
      "type": "object"
    },
    "Categoria": {
      "enum": ["residencial", "comercial", "industrial", "rural"],
      "type": "string"
    },
    "Coordenadas": {
      "additionalProperties": false,
      "properties": {
        "latitud": {
          "type": "number"
        },
        "longitud": {
          "type": "number"
        }
      },
      "required": ["latitud", "longitud"],
      "type": "object"
    },
    "Dispositivo": {
      "additionalProperties": false,
      "description": "Respuesta de POST /dispositivos: el token de Expo registrado para el usuario de la sesión.",
      "properties": {
        "plataforma": {
          "enum": ["ios", "android"],
          "type": "string"
        },
        "tokenExpo": {
          "type": "string"
        }
      },
      "required": ["tokenExpo", "plataforma"],
      "type": "object"
    },
    "EstadoRuta": {
      "enum": ["asignada", "en_curso", "cerrada"],
      "type": "string"
    },
    "Lectura": {
      "additionalProperties": false,
      "properties": {
        "confirmadaPorLector": {
          "type": "boolean"
        },
        "consumo": {
          "type": "number"
        },
        "coordenadas": {
          "anyOf": [
            {
              "$ref": "#/definitions/Coordenadas"
            },
            {
              "type": "null"
            }
          ]
        },
        "fechaHora": {
          "type": "string"
        },
        "fotoUri": {
          "type": "string"
        },
        "fueraDeRango": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "lectorId": {
          "type": "string"
        },
        "rutaId": {
          "type": "string"
        },
        "sincronizada": {
          "type": "boolean"
        },
        "suministroId": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "rutaId",
        "suministroId",
        "lectorId",
        "valor",
        "consumo",
        "fotoUri",
        "coordenadas",
        "fueraDeRango",
        "confirmadaPorLector",
        "fechaHora",
        "sincronizada"
      ],
      "type": "object"
    },
    "Medidor": {
      "additionalProperties": false,
      "properties": {
        "codigoQr": {
          "type": ["string", "null"]
        },
        "digitos": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "instaladoEn": {
          "type": "string"
        },
        "modelo": {
          "$ref": "#/definitions/ModeloMedidor"
        },
        "multiplicador": {
          "type": "number"
        },
        "serie": {
          "type": "string"
        },
        "videoInstructivoUrl": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "serie",
        "modelo",
        "multiplicador",
        "digitos",
        "videoInstructivoUrl",
        "codigoQr",
        "instaladoEn"
      ],
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Paginación de toda respuesta de lista.",
      "properties": {
        "pagina": {
          "type": "number"
        },
        "porPagina": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "required": ["total", "pagina", "porPagina"],
      "type": "object"
    },
    "ModeloMedidor": {
      "enum": ["agujas", "agujas_viejo", "digital", "multiplicador"],
      "type": "string"
    },
    "MotivoNovedad": {
      "enum": [
        "perro_suelto",
        "porton_cerrado",
        "pasto_alto",
        "medidor_tapado",
        "medidor_roto",
        "deshabitada",
        "no_se_encuentra"
      ],
      "type": "string"
    },
    "Novedad": {
      "additionalProperties": false,
      "properties": {
        "audioUri": {
          "type": ["string", "null"]
        },
        "comentario": {
          "type": ["string", "null"]
        },
        "fechaHora": {
          "type": "string"
        },
        "fotoUri": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lectorId": {
          "type": "string"
        },
        "motivo": {
          "$ref": "#/definitions/MotivoNovedad"
        },
        "rutaId": {
          "type": "string"
        },
        "sincronizada": {
          "type": "boolean"
        },
        "suministroId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rutaId",
        "suministroId",
        "lectorId",
        "motivo",
        "comentario",
        "audioUri",
        "fotoUri",
        "fechaHora",
        "sincronizada"
      ],
      "type": "object"
    },
    "PaqueteRuta": {
      "additionalProperties": false,
      "description": "Respuesta de POST /rutas/:id/descarga: la jornada completa, sin paginar.",
      "properties": {
        "lecturas": {
          "description": "Las vigentes que el servidor ya tiene de esa ruta.",
          "items": {
            "$ref": "#/definitions/Lectura"
          },
          "type": "array"
        },
        "medidores": {
          "description": "Los de esos suministros, uno por suministro, en el mismo orden.",
          "items": {
            "$ref": "#/definitions/Medidor"
          },
          "type": "array"
        },
        "novedades": {
          "description": "Ídem.",
          "items": {
            "$ref": "#/definitions/Novedad"
          },
          "type": "array"
        },
        "ruta": {
          "$ref": "#/definitions/Ruta"
        },
        "suministros": {
          "description": "En el orden de `ruta.suministroIds`.",
          "items": {
            "$ref": "#/definitions/Suministro"
          },
          "type": "array"
        }
      },
      "required": ["ruta", "suministros", "medidores", "lecturas", "novedades"],
      "type": "object"
    },
    "PruebaPush": {
      "additionalProperties": false,
      "description": "Respuesta de POST /dispositivos/prueba: a cuántos dispositivos del usuario se mandó la push.",
      "properties": {
        "dispositivos": {
          "type": "number"
        }
      },
      "required": ["dispositivos"],
      "type": "object"
    },
    "RespuestaError": {
      "additionalProperties": false,
      "description": "Error: { error: { codigo, mensaje } } — sin otros campos.",
      "properties": {
        "error": {
          "additionalProperties": false,
          "properties": {
            "codigo": {
              "type": "string"
            },
            "mensaje": {
              "type": "string"
            }
          },
          "required": ["codigo", "mensaje"],
          "type": "object"
        }
      },
      "required": ["error"],
      "type": "object"
    },
    "Rol": {
      "enum": ["lector", "administracion"],
      "type": "string"
    },
    "Ruta": {
      "additionalProperties": false,
      "properties": {
        "bimestre": {
          "type": "string"
        },
        "cerradaEn": {
          "type": ["string", "null"]
        },
        "descargadaEn": {
          "type": ["string", "null"]
        },
        "estado": {
          "$ref": "#/definitions/EstadoRuta"
        },
        "id": {
          "type": "string"
        },
        "lectorId": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "suministroIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "numero",
        "nombre",
        "bimestre",
        "lectorId",
        "suministroIds",
        "estado",
        "descargadaEn",
        "cerradaEn"
      ],
      "type": "object"
    },
    "Salud": {
      "additionalProperties": false,
      "description": "Respuesta de GET /salud.",
      "properties": {
        "almacen": {
          "enum": [
            "local",
            "aws",
            "supabase",
            "r2",
            "b2",
            "s3proxy",
            "localstack"
          ],
          "type": "string"
        },
        "estado": {
          "const": "ok",
          "type": "string"
        },
        "motor": {
          "enum": ["better-sqlite3", "postgres", "mysql", "mariadb"],
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["estado", "motor", "almacen", "version"],
      "type": "object"
    },
    "Sesion": {
      "additionalProperties": false,
      "description": "Respuesta de POST /auth/registro y POST /auth/ingreso.",
      "properties": {
        "token": {
          "type": "string"
        },
        "usuario": {
          "$ref": "#/definitions/Usuario"
        }
      },
      "required": ["token", "usuario"],
      "type": "object"
    },
    "Suministro": {
      "additionalProperties": false,
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "categoria": {
          "$ref": "#/definitions/Categoria"
        },
        "consumoPromedio": {
          "type": ["number", "null"]
        },
        "coordenadas": {
          "$ref": "#/definitions/Coordenadas"
        },
        "direccion": {
          "type": "string"
        },
        "fechaLecturaAnterior": {
          "type": ["string", "null"]
        },
        "id": {
          "type": "string"
        },
        "lecturaAnterior": {
          "type": ["number", "null"]
        },
        "medidorId": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "titular": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "numero",
        "titular",
        "direccion",
        "coordenadas",
        "categoria",
        "medidorId",
        "lecturaAnterior",
        "fechaLecturaAnterior",
        "consumoPromedio",
        "activo"
      ],
      "type": "object"
    },
    "Usuario": {
      "additionalProperties": false,
      "properties": {
        "biometriaActiva": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "legajo": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "rol": {
          "$ref": "#/definitions/Rol"
        },
        "rutasAsignadas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "legajo",
        "nombre",
        "rol",
        "biometriaActiva",
        "rutasAsignadas"
      ],
      "type": "object"
    }
  }
}
