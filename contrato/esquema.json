{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArchivoSubido": {
      "additionalProperties": false,
      "description": "Respuesta de POST /archivos.",
      "properties": {
        "bytes": {
          "type": "number"
        },
        "tipo": {
          "enum": [
            "imagen",
            "audio",
            "video"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "tipo",
        "bytes"
      ],
      "type": "object"
    },
    "Aviso": {
      "additionalProperties": false,
      "properties": {
        "desde": {
          "type": "string"
        },
        "detalle": {
          "type": "string"
        },
        "gravedad": {
          "$ref": "#/definitions/Gravedad"
        },
        "hasta": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lineaIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "titulo": {
          "type": "string"
        },
        "trazadoAlternativo": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/Coordenadas"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "videoUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "titulo",
        "detalle",
        "lineaIds",
        "desde",
        "hasta",
        "gravedad",
        "trazadoAlternativo",
        "videoUrl"
      ],
      "type": "object"
    },
    "Coordenadas": {
      "additionalProperties": false,
      "properties": {
        "latitud": {
          "type": "number"
        },
        "longitud": {
          "type": "number"
        }
      },
      "required": [
        "latitud",
        "longitud"
      ],
      "type": "object"
    },
    "Dispositivo": {
      "additionalProperties": false,
      "description": "Respuesta de POST /dispositivos: el token de push registrado.",
      "properties": {
        "plataforma": {
          "enum": [
            "android",
            "ios"
          ],
          "type": "string"
        },
        "tokenExpo": {
          "type": "string"
        }
      },
      "required": [
        "tokenExpo",
        "plataforma"
      ],
      "type": "object"
    },
    "Gravedad": {
      "enum": [
        "informativo",
        "desvio",
        "suspension"
      ],
      "type": "string"
    },
    "Horario": {
      "additionalProperties": false,
      "properties": {
        "hora": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineaId": {
          "type": "string"
        },
        "paradaId": {
          "type": "string"
        },
        "sentido": {
          "$ref": "#/definitions/Sentido"
        },
        "tipoDeDia": {
          "$ref": "#/definitions/TipoDeDia"
        }
      },
      "required": [
        "id",
        "lineaId",
        "paradaId",
        "sentido",
        "tipoDeDia",
        "hora"
      ],
      "type": "object"
    },
    "Linea": {
      "additionalProperties": false,
      "properties": {
        "activa": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "empresa": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "recorridos": {
          "items": {
            "$ref": "#/definitions/Recorrido"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "numero",
        "nombre",
        "color",
        "empresa",
        "recorridos",
        "activa"
      ],
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Paginación de toda respuesta de lista.",
      "properties": {
        "pagina": {
          "type": "number"
        },
        "porPagina": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "required": [
        "total",
        "pagina",
        "porPagina"
      ],
      "type": "object"
    },
    "MotivoDemora": {
      "enum": [
        "no_paso",
        "paso_lleno",
        "demorado",
        "unidad_rota",
        "calle_cortada"
      ],
      "type": "string"
    },
    "Parada": {
      "additionalProperties": false,
      "properties": {
        "codigoQr": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordenadas": {
          "$ref": "#/definitions/Coordenadas"
        },
        "id": {
          "type": "string"
        },
        "lineaIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nombre": {
          "type": "string"
        },
        "refugio": {
          "type": "boolean"
        },
        "sentido": {
          "$ref": "#/definitions/Sentido"
        }
      },
      "required": [
        "id",
        "nombre",
        "coordenadas",
        "lineaIds",
        "sentido",
        "refugio",
        "codigoQr"
      ],
      "type": "object"
    },
    "PruebaDePush": {
      "additionalProperties": false,
      "description": "Respuesta de POST /dispositivos/prueba.",
      "properties": {
        "enviadas": {
          "type": "number"
        }
      },
      "required": [
        "enviadas"
      ],
      "type": "object"
    },
    "Recorrido": {
      "additionalProperties": false,
      "properties": {
        "destino": {
          "type": "string"
        },
        "paradaIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sentido": {
          "$ref": "#/definitions/Sentido"
        },
        "trazado": {
          "items": {
            "$ref": "#/definitions/Coordenadas"
          },
          "type": "array"
        }
      },
      "required": [
        "sentido",
        "destino",
        "trazado",
        "paradaIds"
      ],
      "type": "object"
    },
    "ReporteDeDemora": {
      "additionalProperties": false,
      "properties": {
        "comentario": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmaciones": {
          "type": "number"
        },
        "fechaHora": {
          "type": "string"
        },
        "fotoUri": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lineaId": {
          "type": "string"
        },
        "motivo": {
          "$ref": "#/definitions/MotivoDemora"
        },
        "paradaId": {
          "type": "string"
        },
        "sincronizado": {
          "type": "boolean"
        },
        "usuarioId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "lineaId",
        "paradaId",
        "usuarioId",
        "motivo",
        "comentario",
        "fotoUri",
        "confirmaciones",
        "fechaHora",
        "sincronizado"
      ],
      "type": "object"
    },
    "RespuestaError": {
      "additionalProperties": false,
      "description": "Error: { error: { codigo, mensaje } } — sin otros campos.",
      "properties": {
        "error": {
          "additionalProperties": false,
          "properties": {
            "codigo": {
              "type": "string"
            },
            "mensaje": {
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "mensaje"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Salud": {
      "additionalProperties": false,
      "description": "Respuesta de GET /salud.",
      "properties": {
        "almacen": {
          "enum": [
            "local",
            "aws",
            "supabase",
            "r2",
            "b2",
            "s3proxy",
            "localstack"
          ],
          "type": "string"
        },
        "estado": {
          "const": "ok",
          "type": "string"
        },
        "motor": {
          "enum": [
            "better-sqlite3",
            "postgres",
            "mysql",
            "mariadb"
          ],
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "estado",
        "motor",
        "almacen",
        "version"
      ],
      "type": "object"
    },
    "Sentido": {
      "enum": [
        "ida",
        "vuelta"
      ],
      "type": "string"
    },
    "Sesion": {
      "additionalProperties": false,
      "description": "Respuesta de POST /auth/registro y POST /auth/ingreso.",
      "properties": {
        "token": {
          "type": "string"
        },
        "usuario": {
          "$ref": "#/definitions/Usuario"
        }
      },
      "required": [
        "token",
        "usuario"
      ],
      "type": "object"
    },
    "Tema": {
      "enum": [
        "claro",
        "oscuro",
        "sistema"
      ],
      "type": "string"
    },
    "TipoDeDia": {
      "enum": [
        "habil",
        "sabado",
        "domingo",
        "feriado"
      ],
      "type": "string"
    },
    "Usuario": {
      "additionalProperties": false,
      "properties": {
        "avisosActivos": {
          "type": "boolean"
        },
        "email": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineasFavoritas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nombre": {
          "type": "string"
        },
        "paradasFavoritas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tema": {
          "$ref": "#/definitions/Tema"
        }
      },
      "required": [
        "id",
        "nombre",
        "email",
        "lineasFavoritas",
        "paradasFavoritas",
        "avisosActivos",
        "tema"
      ],
      "type": "object"
    }
  }
}