{
  "name": "api-reservas-deportivas",
  "version": "0.1.0",
  "description": "API del Trabajo Final — Reservas Deportivas · Villaguay",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "archivos:probar": "nest build && node dist/src/herramientas/archivos-probar.js",
    "build": "nest build",
    "contrato:esquema": "ts-json-schema-generator --path 'contrato/*.ts' --type '*' --no-type-check --out contrato/esquema.json",
    "db:probar": "nest build && node dist/src/herramientas/db-probar.js",
    "db:reiniciar": "nest build && node dist/src/semillas/reiniciar.js",
    "dev": "nest start --watch",
    "docker:probar": "node scripts/probar-docker.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "oxlint --deny-warnings src/ test/ scripts/",
    "publicado:probar": "node scripts/publicado-probar.mjs",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:matriz": "node scripts/matriz.mjs",
    "test:watch": "vitest",
    "verificar": "tsc --noEmit && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@date-fns/tz": "^1.5.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
