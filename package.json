{
  "name": "api-directorio-comercios",
  "version": "0.1.0",
  "description": "API del Directorio de Comercios de Concepción del Uruguay (Trabajo Final, Desarrollo para Móviles, UNER)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"contract/api.ts\"",
    "lint": "oxlint --deny-warnings src/ test/ scripts/ && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:notificaciones": "vitest run --config ./vitest.config.notifications.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:matriz": "node scripts/matrix.mjs",
    "contrato:esquema": "ts-json-schema-generator --path \"contract/*.ts\" --type \"*\" --no-type-check --out contract/schema.json",
    "db:reiniciar": "nest build && node dist/src/seeds/reset.js",
    "verificar": "pnpm contrato:esquema && pnpm tipos && pnpm lint && pnpm test && pnpm test:e2e",
    "docker:probar": "node scripts/test-docker.mjs",
    "docs:readme": "ACTUALIZAR_README=1 vitest run --config ./vitest.config.e2e.ts test/e2e/readme.e2e-spec.ts",
    "db:probar": "nest build && node dist/src/tools/test-db.js",
    "archivos:probar": "nest build && node dist/src/tools/test-files.js",
    "publicado:probar": "node scripts/test-published.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@date-fns/tz": "^1.5.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
