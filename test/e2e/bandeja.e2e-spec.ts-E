import { crearApp, type AppDePrueba } from '../utilidades/crear-app.js';
import { esperarContrato, esperarError } from '../utilidades/contrato.js';
import {
  crearCuadrilla,
  crearTipo,
  crearZona,
} from '../utilidades/catalogos.js';
import {
  crearOperador,
  crearVecino,
  type UsuarioDePrueba,
} from '../utilidades/usuarios.js';
import {
  crearCambio,
  crearReporte,
  subirArchivo,
  subirAudio,
} from '../utilidades/reportes.js';
import { parsearInstante } from '../../src/comun/fechas/fechas.js';
import type { EstadoReporte } from '../../contrato/tipos.js';
import { Adhesion } from '../../src/modulos/reportes/adhesion.entidad.js';
import { CambioDeEstado } from '../../src/modulos/reportes/cambio-de-estado.entidad.js';
import { FotoDeReporte } from '../../src/modulos/reportes/foto.entidad.js';
import { Reporte } from '../../src/modulos/reportes/reporte.entidad.js';

let ctx: AppDePrueba;
let autor: UsuarioDePrueba;
let ana: UsuarioDePrueba;
let operador: UsuarioDePrueba;
let otroOperador: UsuarioDePrueba;
let operadorSur: UsuarioDePrueba;
let operadorSinZona: UsuarioDePrueba;
let tipoId: string;
let otroTipoId: string;
const zonaNorte = 'zon-norte';
const zonaSur = 'zon-sur';
let cuadrillaNorte: string;
let cuadrillaNorte2: string;
let cuadrillaSur: string;
let cuadrillaInactiva: string;

beforeAll(async () => {
  ctx = await crearApp();
  autor = await crearVecino(ctx);
  ana = await crearVecino(ctx);
  operador = await crearOperador(ctx, { zonaId: zonaNorte });
  otroOperador = await crearOperador(ctx, { zonaId: zonaNorte });
  operadorSur = await crearOperador(ctx, { zonaId: zonaSur });
  operadorSinZona = await crearOperador(ctx, { zonaId: null });
  tipoId = (await crearTipo(ctx, { id: 'tip-bache' })).id;
  otroTipoId = (await crearTipo(ctx, { id: 'tip-luz', nombre: 'Luz' })).id;
  await crearZona(ctx, { id: zonaNorte });
  await crearZona(ctx, { id: zonaSur });
  cuadrillaNorte = (await crearCuadrilla(ctx, { zonaId: zonaNorte })).id;
  cuadrillaNorte2 = (await crearCuadrilla(ctx, { zonaId: zonaNorte })).id;
  cuadrillaSur = (await crearCuadrilla(ctx, { zonaId: zonaSur })).id;
  cuadrillaInactiva = (
    await crearCuadrilla(ctx, { zonaId: zonaNorte, activa: false })
  ).id;
});
afterAll(() => ctx.cerrar());

beforeEach(async () => {
  await ctx.dataSource.getRepository(Adhesion).clear();
  await ctx.dataSource.getRepository(CambioDeEstado).clear();
  await ctx.dataSource.getRepository(FotoDeReporte).clear();
  await ctx.dataSource.getRepository(Reporte).clear();
});

const reporte = (
  estado: EstadoReporte = 'recibido',
  extra: Partial<Reporte> = {},
) =>
  crearReporte(ctx, {
    autorId: autor.usuario.id,
    tipoId,
    zonaId: zonaNorte,
    estado,
    ...extra,
  });

const como = (req: import('supertest').Test, quien?: UsuarioDePrueba | null) =>
  quien ? req.set(...quien.auth) : req;

const bandeja = (query = '', quien: UsuarioDePrueba | null = operador) =>
  como(ctx.http().get(`/bandeja${query}`), quien);
const cambiarEstado = (
  id: string,
  cuerpo: unknown,
  quien: UsuarioDePrueba | null = operador,
) =>
  como(
    ctx
      .http()
      .patch(`/reportes/${id}/estado`)
      .send(cuerpo as object),
    quien,
  );
const asignar = (
  id: string,
  cuerpo: unknown,
  quien: UsuarioDePrueba | null = operador,
) =>
  como(
    ctx
      .http()
      .patch(`/reportes/${id}/cuadrilla`)
      .send(cuerpo as object),
    quien,
  );
const marcarDuplicado = (
  id: string,
  cuerpo: unknown,
  quien: UsuarioDePrueba | null = operador,
) =>
  como(
    ctx
      .http()
      .post(`/reportes/${id}/duplicado`)
      .send(cuerpo as object),
    quien,
  );
const agregarFoto = (
  id: string,
  cuerpo: unknown,
  quien: UsuarioDePrueba | null = operador,
) =>
  como(
    ctx
      .http()
      .post(`/reportes/${id}/fotos`)
      .send(cuerpo as object),
    quien,
  );

const cambiosDe = (reporteId: string) =>
  ctx.dataSource
    .getRepository(CambioDeEstado)
    .find({ where: { reporteId }, order: { secuencia: 'ASC' } });
const enBase = (id: string) =>
  ctx.dataSource.getRepository(Reporte).findOneByOrFail({ id });

describe('GET /bandeja', () => {
  it('401 sin token y 403 para un vecino (R17)', async () => {
    esperarError(await bandeja('', null), 401, 'NO_AUTENTICADO');
    esperarError(await bandeja('', ana), 403, 'SIN_PERMISO');
  });

  it('lista vacía: datos [] y meta con total 0', async () => {
    const res = await bandeja();
    expect(res.status).toBe(200);
    esperarContrato(res, 'Reporte');
    expect(res.body.datos).toEqual([]);
    expect(res.body.meta).toEqual({ total: 0, pagina: 1, porPagina: 20 });
  });

  it('sólo trae los abiertos', async () => {
    const abiertos = await Promise.all(
      (['recibido', 'en_revision', 'asignado'] as const).map((e) => reporte(e)),
    );
    await reporte('resuelto');
    await reporte('rechazado');
    const res = await bandeja();
    esperarContrato(res, 'Reporte');
    expect(
      (res.body.datos as { id: string }[]).map((r) => r.id).sort(),
    ).toEqual(abiertos.map((r) => r.id).sort());
    expect(res.body.meta.total).toBe(3);
  });

  it('orden: adhesiones descendente y, a igualdad, el más viejo primero (desempate por id)', async () => {
    const t = (iso: string) => parsearInstante(iso)!;
    const viejo = await reporte('recibido', {
      creadoEn: t('2026-09-01T10:00:00-03:00'),
    });
    const nuevo = await reporte('recibido', {
      creadoEn: t('2026-09-10T10:00:00-03:00'),
    });
    const popular = await reporte('recibido', {
      creadoEn: t('2026-09-12T10:00:00-03:00'),
      adhesiones: 7,
    });
    const mismoInstante = await Promise.all(
      ['rep-bbb', 'rep-aaa'].map((id) =>
        reporte('recibido', {
          id,
          creadoEn: t('2026-09-05T10:00:00-03:00'),
        }),
      ),
    );
    const res = await bandeja();
    expect((res.body.datos as { id: string }[]).map((r) => r.id)).toEqual([
      popular.id,
      viejo.id,
      mismoInstante[1].id,
      mismoInstante[0].id,
      nuevo.id,
    ]);
  });

  it('D11 — por defecto muestra la zona del operador', async () => {
    const norte = await reporte('recibido', { zonaId: zonaNorte });
    const sur = await reporte('recibido', { zonaId: zonaSur });
    const delNorte = await bandeja('', operador);
    expect((delNorte.body.datos as { id: string }[]).map((r) => r.id)).toEqual([
      norte.id,
    ]);
    const delSur = await bandeja('', operadorSur);
    expect((delSur.body.datos as { id: string }[]).map((r) => r.id)).toEqual([
      sur.id,
    ]);
  });

  it('D11 — zonaId=todas ve todo; zonaId=<zona> ve esa; un operador sin zona ve todo', async () => {
    await reporte('recibido', { zonaId: zonaNorte });
    await reporte('recibido', { zonaId: zonaSur });
    expect((await bandeja('?zonaId=todas')).body.meta.total).toBe(2);
    expect((await bandeja('?zonaId=zon-sur')).body.meta.total).toBe(1);
    expect((await bandeja('', operadorSinZona)).body.meta.total).toBe(2);
    expect((await bandeja('?zonaId=zon-inexistente')).body.meta.total).toBe(0);
  });

  it('filtros estado (uno o varios) y tipoId', async () => {
    await reporte('recibido');
    await reporte('en_revision');
    await reporte('asignado', { tipoId: otroTipoId });
    expect((await bandeja('?estado=en_revision')).body.meta.total).toBe(1);
    expect(
      (await bandeja('?estado=en_revision,asignado')).body.meta.total,
    ).toBe(2);
    expect((await bandeja(`?tipoId=${otroTipoId}`)).body.meta.total).toBe(1);
    expect(
      (await bandeja(`?tipoId=${tipoId}&estado=asignado`)).body.meta.total,
    ).toBe(0);
  });

  it.each([
    '?estado=resuelto',
    '?estado=rechazado',
    '?estado=cualquiera',
    '?estado=',
    '?estado=recibido,',
    '?zonaId=norte',
    '?tipoId=bache',
    '?porPagina=101',
    '?pagina=0',
  ])('400 con %s', async (consulta) => {
    esperarError(await bandeja(consulta), 400, 'VALIDACION_FALLIDA');
  });

  it('paginación: meta correcto y página fuera de rango', async () => {
    for (let i = 0; i < 5; i++) await reporte();
    const p2 = await bandeja('?pagina=2&porPagina=2');
    expect(p2.body.datos).toHaveLength(2);
    expect(p2.body.meta).toEqual({ total: 5, pagina: 2, porPagina: 2 });
    const fuera = await bandeja('?pagina=9&porPagina=2');
    expect(fuera.body.datos).toEqual([]);
    expect(fuera.body.meta.total).toBe(5);
  });
});

describe('PATCH /reportes/:id/estado', () => {
  it('401, 403 (R17), 404 y 400 por id mal formado', async () => {
    const r = await reporte();
    esperarError(
      await cambiarEstado(r.id, { estado: 'en_revision' }, undefined),
      401,
      'NO_AUTENTICADO',
    );
    esperarError(
      await cambiarEstado(r.id, { estado: 'en_revision' }, autor),
      403,
      'SIN_PERMISO',
    );
    esperarError(
      await cambiarEstado('rep-noexiste', { estado: 'en_revision' }),
      404,
      'REPORTE_NO_ENCONTRADO',
    );
    esperarError(
      await cambiarEstado('xx', { estado: 'en_revision' }),
      400,
      'VALIDACION_FALLIDA',
    );
  });

  it('R11/R16 — recibido → en_revision: 200 con el Reporte y un CambioDeEstado con el operador', async () => {
    const r = await reporte();
    const res = await cambiarEstado(r.id, {
      estado: 'en_revision',
      comentario: 'Lo vemos con Obras Públicas.',
    });
    expect(res.status).toBe(200);
    esperarContrato(res, 'Reporte');
    expect(res.body.datos.estado).toBe('en_revision');
    expect(res.body.datos.id).toBe(r.id);

    const cambios = await ctx.http().get(`/reportes/${r.id}/cambios`);
    esperarContrato(cambios, 'CambioDeEstado');
    expect(cambios.body.datos).toHaveLength(1);
    expect(cambios.body.datos[0]).toMatchObject({
      reporteId: r.id,
      estado: 'en_revision',
      comentario: 'Lo vemos con Obras Públicas.',
      operadorId: operador.usuario.id,
      fechaHora: '2026-09-14T10:00:00-03:00',
    });
    expect(cambios.body.datos[0].id).toMatch(/^cam-/);
  });

  it('un operador de otra zona también puede actuar (D11)', async () => {
    const r = await reporte('recibido', { zonaId: zonaNorte });
    expect(
      (await cambiarEstado(r.id, { estado: 'en_revision' }, operadorSur))
        .status,
    ).toBe(200);
  });

  it('el comentario se recorta y uno vacío se guarda null', async () => {
    const r = await reporte();
    await cambiarEstado(r.id, { estado: 'en_revision', comentario: '   ' });
    const [c] = await cambiosDe(r.id);
    expect(c.comentario).toBeNull();
    const r2 = await reporte();
    await cambiarEstado(r2.id, {
      estado: 'en_revision',
      comentario: '  con   espacios ',
    });
    expect((await cambiosDe(r2.id))[0].comentario).toBe('con espacios');
    const r3 = await reporte();
    await cambiarEstado(r3.id, { estado: 'en_revision', comentario: null });
    expect((await cambiosDe(r3.id))[0].comentario).toBeNull();
  });

  it('un comentario largo (más de 400 caracteres) entra', async () => {
    const r = await reporte();
    const largo = 'No corresponde al municipio. '.repeat(20);
    const res = await cambiarEstado(r.id, {
      estado: 'rechazado',
      comentario: largo,
    });
    expect(res.status).toBe(200);
    expect((await cambiosDe(r.id))[0].comentario).toBe(largo.trim());
  });

  it('R11 — asignado sólo por /cuadrilla: CUADRILLA_REQUERIDA', async () => {
    const r = await reporte('en_revision');
    esperarError(
      await cambiarEstado(r.id, { estado: 'asignado' }),
      422,
      'CUADRILLA_REQUERIDA',
    );
    expect((await enBase(r.id)).estado).toBe('en_revision');
  });

  it.each<[EstadoReporte, EstadoReporte]>([
    ['recibido', 'resuelto'],
    ['recibido', 'recibido'],
    ['en_revision', 'resuelto'],
    ['en_revision', 'recibido'],
    ['asignado', 'recibido'],
    ['resuelto', 'en_revision'],
    ['resuelto', 'rechazado'],
    ['rechazado', 'en_revision'],
    ['rechazado', 'resuelto'],
  ])('R11 — %s → %s: TRANSICION_INVALIDA', async (desde, hasta) => {
    const r = await reporte(desde);
    esperarError(
      await cambiarEstado(r.id, { estado: hasta, comentario: 'porque sí' }),
      422,
      'TRANSICION_INVALIDA',
    );
    expect((await enBase(r.id)).estado).toBe(desde);
    expect(await cambiosDe(r.id)).toHaveLength(0);
  });

  it.each<[EstadoReporte, EstadoReporte]>([
    ['asignado', 'resuelto'],
    ['asignado', 'en_revision'],
    ['en_revision', 'rechazado'],
    ['asignado', 'rechazado'],
  ])('R11 — %s → %s es válida', async (desde, hasta) => {
    const r = await reporte(desde);
    const res = await cambiarEstado(r.id, {
      estado: hasta,
      comentario: 'motivo',
    });
    expect(res.status).toBe(200);
    expect(res.body.datos.estado).toBe(hasta);
  });

  it('R12 — rechazar exige motivo (MOTIVO_REQUERIDO)', async () => {
    const r = await reporte();
    for (const cuerpo of [
      { estado: 'rechazado' },
      { estado: 'rechazado', comentario: null },
      { estado: 'rechazado', comentario: '   ' },
    ]) {
      esperarError(await cambiarEstado(r.id, cuerpo), 422, 'MOTIVO_REQUERIDO');
    }
    expect((await enBase(r.id)).estado).toBe('recibido');
    const ok = await cambiarEstado(r.id, {
      estado: 'rechazado',
      comentario: 'No es de competencia municipal.',
    });
    expect(ok.status).toBe(200);
  });

  it('D6 — resolver no exige foto del arreglo', async () => {
    const r = await reporte('asignado');
    const res = await cambiarEstado(r.id, { estado: 'resuelto' });
    expect(res.status).toBe(200);
    expect(
      res.body.datos.fotos.every(
        (f: { momento: string }) => f.momento === 'problema',
      ),
    ).toBe(true);
  });

  it('asignado → en_revision conserva la cuadrilla asignada', async () => {
    const r = await reporte('asignado', { cuadrillaId: cuadrillaNorte });
    const res = await cambiarEstado(r.id, { estado: 'en_revision' });
    expect(res.body.datos.cuadrillaId).toBe(cuadrillaNorte);
  });

  it.each<[string, unknown]>([
    ['sin estado', {}],
    ['estado null', { estado: null }],
    ['estado que no existe', { estado: 'volando' }],
    ['estado no texto', { estado: 3 }],
    ['comentario que no es texto', { estado: 'en_revision', comentario: 5 }],
    [
      'comentario demasiado largo',
      { estado: 'en_revision', comentario: 'x'.repeat(2001) },
    ],
    ['campo de más', { estado: 'en_revision', operadorId: 'usr-1' }],
  ])('400 %s', async (_nombre, cuerpo) => {
    const r = await reporte();
    esperarError(await cambiarEstado(r.id, cuerpo), 400, 'VALIDACION_FALLIDA');
    expect(await cambiosDe(r.id)).toHaveLength(0);
  });

  it('cambios sucesivos quedan en orden, con el primer recibido intacto', async () => {
    const r = await reporte();
    await crearCambio(ctx, { reporteId: r.id });
    await cambiarEstado(r.id, { estado: 'en_revision' });
    await asignar(r.id, { cuadrillaId: cuadrillaNorte });
    await cambiarEstado(r.id, { estado: 'resuelto', comentario: 'Listo.' });
    const cambios = await ctx.http().get(`/reportes/${r.id}/cambios`);
    esperarContrato(cambios, 'CambioDeEstado');
    expect(
      (cambios.body.datos as { estado: string }[]).map((c) => c.estado),
    ).toEqual(['recibido', 'en_revision', 'asignado', 'resuelto']);
    expect(cambios.body.datos[0].operadorId).toBeNull();
  });

  it('dos operadores a la vez: uno gana y el otro recibe TRANSICION_INVALIDA', async () => {
    const r = await reporte();
    const res = await Promise.all([
      cambiarEstado(r.id, { estado: 'en_revision' }, operador),
      cambiarEstado(
        r.id,
        { estado: 'rechazado', comentario: 'No corresponde.' },
        otroOperador,
      ),
    ]);
    const codigos = res.map((x) => x.status).sort();
    // rechazado gana en cualquier orden; en_revision → rechazado también es válida.
    expect(codigos[0]).toBe(200);
    const cambios = await cambiosDe(r.id);
    expect(cambios.length).toBe(codigos.filter((c) => c === 200).length);
    const final = (await enBase(r.id)).estado;
    expect(final).toBe(cambios[cambios.length - 1].estado);
  });

  it('dos pedidos iguales a la vez: un solo cambio', async () => {
    const r = await reporte();
    const res = await Promise.all([
      cambiarEstado(r.id, { estado: 'en_revision' }, operador),
      cambiarEstado(r.id, { estado: 'en_revision' }, otroOperador),
    ]);
    expect(res.map((x) => x.status).sort()).toEqual([200, 422]);
    expect(await cambiosDe(r.id)).toHaveLength(1);
  });
});

describe('PATCH /reportes/:id/cuadrilla', () => {
  it('401, 403 (R17), 404', async () => {
    const r = await reporte('en_revision');
    esperarError(
      await asignar(r.id, { cuadrillaId: cuadrillaNorte }, undefined),
      401,
      'NO_AUTENTICADO',
    );
    esperarError(
      await asignar(r.id, { cuadrillaId: cuadrillaNorte }, ana),
      403,
      'SIN_PERMISO',
    );
    esperarError(
      await asignar('rep-noexiste', { cuadrillaId: cuadrillaNorte }),
      404,
      'REPORTE_NO_ENCONTRADO',
    );
  });

  it('R14 — asigna y pasa a asignado, con un CambioDeEstado del operador', async () => {
    const r = await reporte('en_revision');
    const res = await asignar(r.id, {
      cuadrillaId: cuadrillaNorte,
      comentario: 'Bacheo de la semana.',
    });
    expect(res.status).toBe(200);
    esperarContrato(res, 'Reporte');
    expect(res.body.datos).toMatchObject({
      estado: 'asignado',
      cuadrillaId: cuadrillaNorte,
    });
    const [c] = await cambiosDe(r.id);
    expect(c).toMatchObject({
      estado: 'asignado',
      comentario: 'Bacheo de la semana.',
      operadorId: operador.usuario.id,
    });
  });

  it('R14 — reasignar crea un nuevo cambio asignado', async () => {
    const r = await reporte('en_revision');
    await asignar(r.id, { cuadrillaId: cuadrillaNorte });
    const res = await asignar(r.id, {
      cuadrillaId: cuadrillaNorte2,
      comentario: 'La primera no tiene el equipo.',
    });
    expect(res.status).toBe(200);
    expect(res.body.datos.cuadrillaId).toBe(cuadrillaNorte2);
    const cambios = await cambiosDe(r.id);
    expect(cambios.map((c) => c.estado)).toEqual(['asignado', 'asignado']);
    expect(cambios[1].comentario).toBe('La primera no tiene el equipo.');
  });

  it.each<EstadoReporte>(['recibido', 'resuelto', 'rechazado'])(
    'R11 — desde %s: TRANSICION_INVALIDA',
    async (estado) => {
      const r = await reporte(estado);
      esperarError(
        await asignar(r.id, { cuadrillaId: cuadrillaNorte }),
        422,
        'TRANSICION_INVALIDA',
      );
      expect((await enBase(r.id)).cuadrillaId).toBeNull();
    },
  );

  it.each<[string, unknown]>([
    ['sin cuadrillaId', {}],
    ['cuadrillaId null', { cuadrillaId: null }],
    ['cuadrillaId vacío', { cuadrillaId: '' }],
  ])('CUADRILLA_REQUERIDA (422) %s', async (_n, cuerpo) => {
    const r = await reporte('en_revision');
    esperarError(await asignar(r.id, cuerpo), 422, 'CUADRILLA_REQUERIDA');
  });

  it('CUADRILLA_NO_ENCONTRADA (422)', async () => {
    const r = await reporte('en_revision');
    esperarError(
      await asignar(r.id, { cuadrillaId: 'cua-noexiste' }),
      422,
      'CUADRILLA_NO_ENCONTRADA',
    );
  });

  it('CUADRILLA_INACTIVA (422)', async () => {
    const r = await reporte('en_revision');
    esperarError(
      await asignar(r.id, { cuadrillaId: cuadrillaInactiva }),
      422,
      'CUADRILLA_INACTIVA',
    );
    expect(await cambiosDe(r.id)).toHaveLength(0);
  });

  it('CUADRILLA_DE_OTRA_ZONA (422) — D4', async () => {
    const r = await reporte('en_revision');
    esperarError(
      await asignar(r.id, { cuadrillaId: cuadrillaSur }),
      422,
      'CUADRILLA_DE_OTRA_ZONA',
    );
    expect((await enBase(r.id)).estado).toBe('en_revision');
  });

  it.each<[string, unknown]>([
    ['cuadrillaId con otro prefijo', { cuadrillaId: 'rep-abc' }],
    ['cuadrillaId no texto', { cuadrillaId: 4 }],
    ['comentario no texto', { cuadrillaId: 'cua-x', comentario: 4 }],
    ['campo de más', { cuadrillaId: 'cua-x', estado: 'resuelto' }],
  ])('400 %s', async (_n, cuerpo) => {
    const r = await reporte('en_revision');
    esperarError(await asignar(r.id, cuerpo), 400, 'VALIDACION_FALLIDA');
  });

  it('dos asignaciones a la vez: quedan dos cambios y la cuadrilla es la del último', async () => {
    const r = await reporte('en_revision');
    const res = await Promise.all([
      asignar(r.id, { cuadrillaId: cuadrillaNorte }, operador),
      asignar(r.id, { cuadrillaId: cuadrillaNorte2 }, otroOperador),
    ]);
    expect(res.every((x) => x.status === 200)).toBe(true);
    expect(await cambiosDe(r.id)).toHaveLength(2);
    expect(['asignado']).toEqual([(await enBase(r.id)).estado]);
  });
});

describe('POST /reportes/:id/duplicado', () => {
  const adhesionesEnBase = async (id: string) => (await enBase(id)).adhesiones;

  it('401, 403 (R17), 404, 400', async () => {
    const [r, o] = [await reporte(), await reporte()];
    esperarError(
      await marcarDuplicado(r.id, { originalId: o.id }, undefined),
      401,
      'NO_AUTENTICADO',
    );
    esperarError(
      await marcarDuplicado(r.id, { originalId: o.id }, ana),
      403,
      'SIN_PERMISO',
    );
    esperarError(
      await marcarDuplicado('rep-noexiste', { originalId: o.id }),
      404,
      'REPORTE_NO_ENCONTRADO',
    );
    for (const cuerpo of [
      {},
      { originalId: null },
      { originalId: 'xx' },
      { originalId: 3 },
      { originalId: o.id, otro: 1 },
    ]) {
      esperarError(
        await marcarDuplicado(r.id, cuerpo),
        400,
        'VALIDACION_FALLIDA',
      );
    }
  });

  it('R13 — queda rechazado, con duplicadoDe y comentario automático; el autor se suma al original', async () => {
    const original = await reporte('en_revision');
    const autorDelDuplicado = ana;
    const dup = await reporte('recibido', {
      autorId: autorDelDuplicado.usuario.id,
    });
    const res = await marcarDuplicado(dup.id, { originalId: original.id });
    expect(res.status).toBe(200);
    esperarContrato(res, 'Reporte');
    expect(res.body.datos).toMatchObject({
      id: dup.id,
      estado: 'rechazado',
      duplicadoDe: original.id,
    });

    const [c] = await cambiosDe(dup.id);
    expect(c).toMatchObject({
      estado: 'rechazado',
      comentario: `Duplicado de ${original.codigo}`,
      operadorId: operador.usuario.id,
    });

    expect(await adhesionesEnBase(original.id)).toBe(1);
    const filas = await ctx.dataSource
      .getRepository(Adhesion)
      .findBy({ reporteId: original.id });
    expect(filas.map((f) => f.usuarioId)).toEqual([
      autorDelDuplicado.usuario.id,
    ]);
    const publico = await ctx.http().get(`/reportes/${original.id}`);
    expect(publico.body.datos.adhesiones).toBe(1);
  });

  it('R13 — si el autor ya estaba sumado, el contador no cambia', async () => {
    const original = await reporte();
    const dup = await reporte('recibido', { autorId: ana.usuario.id });
    await ctx
      .http()
      .post(`/reportes/${original.id}/adhesiones`)
      .set(...ana.auth);
    await marcarDuplicado(dup.id, { originalId: original.id });
    expect(await adhesionesEnBase(original.id)).toBe(1);
    expect(await ctx.dataSource.getRepository(Adhesion).count()).toBe(1);
  });

  it('R13 — si el autor del duplicado es el del original, no se suma (R10)', async () => {
    const original = await reporte();
    const dup = await reporte();
    const res = await marcarDuplicado(dup.id, { originalId: original.id });
    expect(res.status).toBe(200);
    expect(await adhesionesEnBase(original.id)).toBe(0);
    expect(await ctx.dataSource.getRepository(Adhesion).count()).toBe(0);
  });

  it('el duplicado sale de /reportes/cercanos y de la bandeja', async () => {
    const original = await reporte();
    const dup = await reporte('recibido', { autorId: ana.usuario.id });
    await marcarDuplicado(dup.id, { originalId: original.id });
    const b = await bandeja();
    expect((b.body.datos as { id: string }[]).map((x) => x.id)).toEqual([
      original.id,
    ]);
  });

  it('repetir el mismo pedido: 200 sin duplicar cambios ni adhesiones', async () => {
    const original = await reporte();
    const dup = await reporte('recibido', { autorId: ana.usuario.id });
    const a = await marcarDuplicado(dup.id, { originalId: original.id });
    const b = await marcarDuplicado(dup.id, { originalId: original.id });
    expect(b.status).toBe(200);
    expect(b.body).toEqual(a.body);
    expect(await cambiosDe(dup.id)).toHaveLength(1);
    expect(await adhesionesEnBase(original.id)).toBe(1);
  });

  it('DUPLICADO_INVALIDO — de sí mismo', async () => {
    const r = await reporte();
    esperarError(
      await marcarDuplicado(r.id, { originalId: r.id }),
      422,
      'DUPLICADO_INVALIDO',
    );
  });

  it('DUPLICADO_INVALIDO — original que no existe', async () => {
    const r = await reporte();
    esperarError(
      await marcarDuplicado(r.id, { originalId: 'rep-noexiste' }),
      422,
      'DUPLICADO_INVALIDO',
    );
  });

  it.each<EstadoReporte>(['resuelto', 'rechazado'])(
    'DUPLICADO_INVALIDO — original %s',
    async (estado) => {
      const original = await reporte(estado);
      const dup = await reporte();
      esperarError(
        await marcarDuplicado(dup.id, { originalId: original.id }),
        422,
        'DUPLICADO_INVALIDO',
      );
      expect((await enBase(dup.id)).estado).toBe('recibido');
    },
  );

  it('DUPLICADO_INVALIDO — original que ya es duplicado de otro', async () => {
    const raiz = await reporte();
    const medio = await reporte('recibido', { autorId: ana.usuario.id });
    const dup = await reporte();
    await marcarDuplicado(medio.id, { originalId: raiz.id });
    esperarError(
      await marcarDuplicado(dup.id, { originalId: medio.id }),
      422,
      'DUPLICADO_INVALIDO',
    );
  });

  it('DUPLICADO_INVALIDO — un reporte que ya es original de otros no puede pasar a ser duplicado', async () => {
    const a = await reporte();
    const b = await reporte();
    const c = await reporte();
    await marcarDuplicado(b.id, { originalId: a.id });
    esperarError(
      await marcarDuplicado(a.id, { originalId: c.id }),
      422,
      'DUPLICADO_INVALIDO',
    );
  });

  it.each<EstadoReporte>(['resuelto', 'rechazado'])(
    'un reporte %s no se puede marcar como duplicado (TRANSICION_INVALIDA)',
    async (estado) => {
      const original = await reporte();
      const dup = await reporte(estado);
      esperarError(
        await marcarDuplicado(dup.id, { originalId: original.id }),
        422,
        'TRANSICION_INVALIDA',
      );
    },
  );

  it('sirve desde en_revision y asignado', async () => {
    const original = await reporte();
    for (const estado of ['en_revision', 'asignado'] as const) {
      const dup = await reporte(estado, { autorId: ana.usuario.id });
      expect(
        (await marcarDuplicado(dup.id, { originalId: original.id })).status,
      ).toBe(200);
    }
  });

  it('varios duplicados a la vez del mismo original: el contador es el real', async () => {
    const original = await reporte();
    const vecinos = await Promise.all([1, 2, 3].map(() => crearVecino(ctx)));
    const dups = await Promise.all(
      vecinos.map((v) => reporte('recibido', { autorId: v.usuario.id })),
    );
    const res = await Promise.all(
      dups.map((d) => marcarDuplicado(d.id, { originalId: original.id })),
    );
    expect(res.every((x) => x.status === 200)).toBe(true);
    expect(await adhesionesEnBase(original.id)).toBe(3);
  });

  it('cruzados a la vez (A de B y B de A): a lo sumo uno queda duplicado', async () => {
    const a = await reporte('recibido', { autorId: ana.usuario.id });
    const b = await reporte();
    const res = await Promise.all([
      marcarDuplicado(a.id, { originalId: b.id }),
      marcarDuplicado(b.id, { originalId: a.id }),
    ]);
    expect(res.filter((x) => x.status === 200)).toHaveLength(1);
    const dups = [await enBase(a.id), await enBase(b.id)].filter(
      (r) => r.duplicadoDe !== null,
    );
    expect(dups).toHaveLength(1);
  });
});

describe('POST /reportes/:id/fotos', () => {
  it('401, 403 (R17), 404, 400', async () => {
    const r = await reporte('asignado');
    const url = await subirArchivo(ctx, operador);
    esperarError(
      await agregarFoto(r.id, { url }, undefined),
      401,
      'NO_AUTENTICADO',
    );
    esperarError(await agregarFoto(r.id, { url }, ana), 403, 'SIN_PERMISO');
    esperarError(
      await agregarFoto('rep-noexiste', { url }),
      404,
      'REPORTE_NO_ENCONTRADO',
    );
    for (const cuerpo of [
      {},
      { url: null },
      { url: 4 },
      { url, id: 'xx' },
      { url, otro: 1 },
    ]) {
      esperarError(await agregarFoto(r.id, cuerpo), 400, 'VALIDACION_FALLIDA');
    }
  });

  it.each<EstadoReporte>(['asignado', 'resuelto'])(
    'R15 — en %s: 201 con la foto momento arreglo al final',
    async (estado) => {
      const r = await reporte(estado, undefined);
      const url = await subirArchivo(ctx, operador);
      const res = await agregarFoto(r.id, { url });
      expect(res.status).toBe(201);
      esperarContrato(res, 'Reporte');
      const fotos = res.body.datos.fotos as {
        id: string;
        url: string;
        momento: string;
      }[];
      expect(fotos.map((f) => f.momento)).toEqual(['problema', 'arreglo']);
      expect(fotos[1].url).toBe(url);
      expect(fotos[1].id).toMatch(/^fot-/);
      expect(res.body.datos.estado).toBe(estado);
    },
  );

  it.each<EstadoReporte>(['recibido', 'en_revision', 'rechazado'])(
    'ESTADO_NO_ADMITE_FOTO (422) en %s',
    async (estado) => {
      const r = await reporte(estado);
      const url = await subirArchivo(ctx, operador);
      esperarError(
        await agregarFoto(r.id, { url }),
        422,
        'ESTADO_NO_ADMITE_FOTO',
      );
      expect(await ctx.dataSource.getRepository(FotoDeReporte).count()).toBe(1);
    },
  );

  it('R15 — hasta tres; la cuarta es VALIDACION_FALLIDA', async () => {
    const r = await reporte('resuelto');
    for (let i = 0; i < 3; i++) {
      const url = await subirArchivo(ctx, operador);
      expect((await agregarFoto(r.id, { url })).status).toBe(201);
    }
    const url = await subirArchivo(ctx, operador);
    esperarError(await agregarFoto(r.id, { url }), 400, 'VALIDACION_FALLIDA');
    const detalle = await ctx.http().get(`/reportes/${r.id}`);
    expect(
      (detalle.body.datos.fotos as { momento: string }[]).filter(
        (f) => f.momento === 'arreglo',
      ),
    ).toHaveLength(3);
  });

  it('las fotos del problema no cuentan para el tope de tres', async () => {
    const r = await reporte('asignado', undefined);
    await ctx.dataSource.getRepository(FotoDeReporte).insert({
      id: 'fot-extra1',
      reporteId: r.id,
      clave: `imagenes/2026/09/${'b'.repeat(24)}.jpg`,
      momento: 'problema',
      orden: 2,
    });
    const url = await subirArchivo(ctx, operador);
    expect((await agregarFoto(r.id, { url })).status).toBe(201);
  });

  it('R2 — ARCHIVO_NO_SUBIDO con una URL ajena, un file:// o un audio', async () => {
    const r = await reporte('asignado');
    const audio = await subirAudio(ctx, operador);
    for (const url of [
      'https://ejemplo.com/foto.jpg',
      'file:///data/foto.jpg',
      audio,
    ]) {
      esperarError(await agregarFoto(r.id, { url }), 422, 'ARCHIVO_NO_SUBIDO');
    }
  });

  it('con id del cliente: repetir el pedido devuelve 200 y no duplica', async () => {
    const r = await reporte('asignado');
    const url = await subirArchivo(ctx, operador);
    const a = await agregarFoto(r.id, { id: 'fot-arreglo-1', url });
    const b = await agregarFoto(r.id, { id: 'fot-arreglo-1', url });
    expect(a.status).toBe(201);
    expect(b.status).toBe(200);
    expect(b.body).toEqual(a.body);
    expect(await ctx.dataSource.getRepository(FotoDeReporte).count()).toBe(2);
  });

  it('ID_EN_USO (409) si el id de la foto es de otro reporte', async () => {
    const r = await reporte('asignado');
    const otro = await reporte('asignado');
    const url = await subirArchivo(ctx, operador);
    await agregarFoto(otro.id, { id: 'fot-arreglo-2', url });
    esperarError(
      await agregarFoto(r.id, { id: 'fot-arreglo-2', url }),
      409,
      'ID_EN_USO',
    );
  });

  it('cinco a la vez: entran tres y dos dan 400', async () => {
    const r = await reporte('asignado');
    const urls = await Promise.all(
      [1, 2, 3, 4, 5].map(() => subirArchivo(ctx, operador)),
    );
    const res = await Promise.all(
      urls.map((url) => agregarFoto(r.id, { url })),
    );
    expect(res.filter((x) => x.status === 201)).toHaveLength(3);
    expect(res.filter((x) => x.status === 400)).toHaveLength(2);
    expect(
      await ctx.dataSource
        .getRepository(FotoDeReporte)
        .countBy({ reporteId: r.id, momento: 'arreglo' }),
    ).toBe(3);
  });
});
